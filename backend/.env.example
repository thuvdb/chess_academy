# ==============================================================================
# CAMS Backend — MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# Cấu hình Cơ sở dữ liệu
DATABASE_URL=postgresql+asyncpg://cams_user:CHANGE_ME_SECURE_POSTGRES_PASSWORD@localhost:5432/cams_db

# Cấu hình Redis & Celery
REDIS_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/1

# Cấu hình JWT & Bảo mật
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cấu hình CORS & Public URL
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# File Upload & Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Chess Engine & AI Models
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=15
YOLO_MODEL_PATH=models/chess_yolov8s.pt

# Seed Defaults
SEED_DEFAULT_PASSWORD=CHANGE_ME_SEED_PASSWORD
DEFAULT_BRANCH_NAME=Cơ sở Chính - Quận 1

# VietQR
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=1234567890
VIETQR_ACCOUNT_NAME=CAMS CHESS ACADEMY

# PayOS & OAuth (Tùy chọn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
