# ==============================================================================
# CAMS (Chess Academy Management System) — MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env: cp .env.example .env
# 2. Thay đổi toàn bộ các giá trị CHANGE_ME bằng secret thật của bạn.
# 3. Tạo secret an toàn bằng terminal: openssl rand -hex 32
# 4. TUYỆT ĐỐI không commit file .env chứa secret thật vào git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MÔI TRƯỜNG ỨNG DỤNG (Application Environment)
# ------------------------------------------------------------------------------
# Chế độ môi trường: "local" (phát triển nội bộ), "uat" (kiểm thử), hoặc "production" (vận hành chính thức)
# Chú ý: Khi APP_ENV=production, hệ thống sẽ tự động tắt Swagger Docs (/docs) và từ chối khởi động nếu JWT_SECRET_KEY ngắn hơn 32 ký tự.
APP_ENV=local

# Bật/tắt chế độ debug (chỉ bật ở local/uat, production bắt buộc false)
DEBUG=true

# Mức độ ghi log hệ thống: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. CỔNG PUBLISH DỊCH VỤ DOCKER (Container Host Ports)
# ------------------------------------------------------------------------------
# Cổng máy chủ tiếp nhận request trực tiếp cho Backend API khi lập trình Local (qua docker-compose.override.yml).
# Trên UAT/Production, Backend chạy qua mạng nội bộ Docker và Nginx reverse proxy, cổng này không mở ra ngoài.
BACKEND_PORT=8000

# Cổng máy chủ tiếp nhận request cho Frontend Web (mặc định: 3000)
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (Database Credentials)
# Khai báo tập trung một nơi, docker-compose tự ghép thành DATABASE_URL
# ------------------------------------------------------------------------------
POSTGRES_USER=cams_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=cams_db

# (Tùy chọn) Ghi đè trực tiếp toàn bộ chuỗi kết nối Database nếu dùng dịch vụ ngoài (Managed Cloud SQL)
# DATABASE_URL=postgresql+asyncpg://cams_user:CHANGE_ME_SECURE_POSTGRES_PASSWORD@localhost:5432/cams_db

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY TASK QUEUE
# ------------------------------------------------------------------------------
# Mật khẩu bảo vệ máy chủ Redis (dùng chuỗi hex ngẫu nhiên: openssl rand -hex 16)
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_HEX

# (Tùy chọn) Ghi đè URL kết nối Redis / Celery nếu dùng cluster bên ngoài
# REDIS_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/0
# CELERY_BROKER_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/1
# CELERY_RESULT_BACKEND=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_HEX@localhost:6379/1

# ------------------------------------------------------------------------------
# 5. XÁC THỰC & JWT (Authentication & Security)
# ------------------------------------------------------------------------------
# Khóa bí mật ký mã hóa JWT token (Bắt buộc tối thiểu 32 ký tự, sinh bằng: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Thuật toán ký JWT (mặc định: HS256)
JWT_ALGORITHM=HS256

# Thời hạn hiệu lực của Access Token tính theo phút (1440 = 24 giờ)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Thời hạn hiệu lực của Refresh Token tính theo ngày (mặc định: 7 ngày)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 6. MẠNG, CORS & PUBLIC URL
# ------------------------------------------------------------------------------
# Danh sách các origin domain Frontend được phép gọi Backend API (phân tách bằng dấu phẩy)
# Ví dụ local: http://localhost:3000,http://localhost:5173
# Ví dụ production: https://cams-app.duckdns.org,https://app.example.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Địa chỉ URL công khai của Backend API (dùng để tạo đường link chữ ký số HMAC tải file)
API_PUBLIC_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 7. QUẢN LÝ TẬP TIN & TẢI LÊN (Upload & Storage)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ file avatar, hình ảnh tải lên
UPLOAD_DIR=uploads

# Dung lượng tối đa cho phép tải lên mỗi tập tin (MB)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 8. CHESS ENGINE (STOCKFISH) & COMPUTER VISION AI (YOLO)
# ------------------------------------------------------------------------------
# Đường dẫn thực thi binary Stockfish engine (trong Docker container: /usr/games/stockfish)
STOCKFISH_PATH=/usr/games/stockfish

# Độ sâu tính toán phân tích thế cờ mặc định của Stockfish (10 - 20)
STOCKFISH_DEPTH=15

# Đường dẫn file trọng số mô hình YOLO nhận diện quân cờ
YOLO_MODEL_PATH=models/chess_yolov8s.pt

# Khóa API Google Gemini AI (phục vụ tính năng AI phân tích ván đấu / trợ lý cờ vua)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 9. KHỞI TẠO DỮ LIỆU MẪU (Seed UAT / Development)
# (Chú ý: Script seed_uat sẽ tự động bị chặn tuyệt đối không cho chạy nếu APP_ENV=production)
# ------------------------------------------------------------------------------
# Mật khẩu khởi tạo chung cho các tài khoản kiểm thử UAT (Super Admin, Teacher, Student...)
SEED_DEFAULT_PASSWORD=CHANGE_ME_SEED_PASSWORD

# Tên chi nhánh chính mặc định được tạo khi seed
DEFAULT_BRANCH_NAME=Cơ sở Chính - Quận 1

# ------------------------------------------------------------------------------
# 10. FRONTEND BUILD & UI CONSTANTS (Được inject vào bundle khi build)
# ------------------------------------------------------------------------------
# Base URL API cho Frontend (mặc định /api khi chạy cùng Nginx reverse proxy)
VITE_API_BASE_URL=/api

# Base URL WebSocket (để trống nếu muốn Frontend tự nhận diện wss:// hoặc ws:// theo domain)
VITE_WS_BASE_URL=

# Múi giờ mặc định hiển thị trên giao diện người dùng
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Số lượng bàn cờ / phần tử phân trang mặc định trên giao diện
VITE_PAGE_SIZE=20

# ------------------------------------------------------------------------------
# 11. TÍCH HỢP BÊN THỨ BA (Tùy chọn - Để trống nếu chưa kích hoạt)
# ------------------------------------------------------------------------------
# VietQR Thông tin tài khoản nhận chuyển khoản
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=1234567890
VIETQR_ACCOUNT_NAME=CAMS CHESS ACADEMY

# Cổng thanh toán PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Đăng nhập mạng xã hội (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng nhập Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
