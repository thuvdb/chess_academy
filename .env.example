# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_USER=cams_user
POSTGRES_PASSWORD=
POSTGRES_DB=cams_db

# Use hex-only values (no special chars) — it is embedded in redis:// URLs
REDIS_PASSWORD=

JWT_SECRET_KEY=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=chess-academy
MINIO_PUBLIC_URL=http://localhost:9000

# Real domains in production, e.g. ["https://app.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
API_PUBLIC_URL=http://localhost:8000
DEBUG=false
